#: front/config.form.php:44
msgid "<p><b>Settings applied !</b></p><p><i>If you have any error, do the command in the ITSM-NG installation folder : <b>bin/console system:clear_cache</b></i></p>"
msgstr "<p><b>Paramètres appliqués !</b></p><p><i>Si vous avez des erreurs, exécutez cette commande dans le dossier d'installation d'ITSM-NG : <b>bin/console system:clear_cache</b></i></p>"

#: front/config.form.php:51
msgid "<p><b>Default settings applied !</b></p><p><i>If you have any error, do the command in the ITSM-NG installation folder : <b>bin/console system:clear_cache</b></i></p>"
msgstr "<p><b>Paramètres par défaut appliqués !</b></p><p><i>Si vous avez des erreurs, exécutez cette commande dans le dossier d'installation d'ITSM-NG : <b>bin/console system:clear_cache</b></i></p>"

